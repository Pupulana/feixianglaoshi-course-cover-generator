# 火山引擎 API 配置
VOLC_API_KEY=your_api_key_here

# SeedDream API Endpoint
SEEDDREAM_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
# SeedDream Model ID (e.g., doubao-seedream-4-5-251128)
VOLC_MODEL=doubao-seedream-4-5-251128

# Vision Model Endpoint (Doubao Seed 1.6 / Vision)
# 注意：Vision 这里的 Endpoint 变成了 /api/v3/responses
VOLC_VISION_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/responses
# Vision Model ID (e.g., doubao-seed-1-6-251015)
VOLC_VISION_MODEL=doubao-seed-1-6-251015
